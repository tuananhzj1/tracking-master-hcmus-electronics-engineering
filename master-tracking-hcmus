javascript:(function(){const PT={PT1:{name:"PT1 - Nghiên cứu",total:60,triet:3,bat_buoc:11,tu_chon:16,luan_van:30},PT2:{name:"PT2 - Ứng dụng (LV)",total:62,triet:3,bat_buoc:11,tu_chon:36,luan_van:12},PT3:{name:"PT3 - Ứng dụng (ĐA)",total:62,triet:3,bat_buoc:17,tu_chon:36,do_an:6}};const C={chung:[{code:"MTR",name:"Triết học",credits:3}],bat_buoc_PT12:[{code:"MDT034",name:"Xử lý tín hiệu số nâng cao",credits:4},{code:"MDT035",name:"Truyền thông vô tuyến nâng cao",credits:4},{code:"MNC",name:"Phương pháp nghiên cứu khoa học",credits:3}],bat_buoc_PT3:[{code:"MDT034",name:"Xử lý tín hiệu số nâng cao",credits:4},{code:"MDT035",name:"Truyền thông vô tuyến nâng cao",credits:4},{code:"MNC",name:"Phương pháp nghiên cứu khoa học",credits:3},{code:"MDT055",name:"Thực tập thực tế",credits:6}],tu_chon:[{code:"MDT047",name:"Các giao thức truyền thông",credits:4},{code:"MDT037",name:"Mạng vô tuyến hợp tác",credits:4},{code:"MDT039",name:"Thiết kế và lập trình nhúng cho IoT",credits:4},{code:"MDT040",name:"Các giao thức dùng trong IoT",credits:4},{code:"MDT051",name:"Mạng cảm biến không dây",credits:4},{code:"MDT042",name:"Xử lý ảnh và Video",credits:4},{code:"MDT043",name:"Đánh giá hiệu năng mạng",credits:4},{code:"MDT052",name:"Thiết kế và qui hoạch mạng",credits:4},{code:"MDT053",name:"An toàn và bảo mật thông tin",credits:4},{code:"MDT054",name:"Trí tuệ nhân tạo",credits:4},{code:"MDT046",name:"Đổi mới sáng tạo",credits:4},{code:"MDT013",name:"Chuyên đề 1",credits:4},{code:"MDT014",name:"Chuyên đề 2",credits:4},{code:"MDT015",name:"Chuyên đề 3",credits:4}],luan_van:[{code:"MLV_PT1",name:"Luận văn tốt nghiệp (PT1)",credits:30},{code:"MLV_PT2",name:"Luận văn tốt nghiệp (PT2)",credits:12},{code:"MLV_PT3",name:"Đồ án tốt nghiệp (PT3)",credits:6}]};const NN={mien_van_bang:{label:"Miễn ngoại ngữ qua văn bằng",desc:"Bằng ĐH toàn thời gian ở nước ngoài / ngành ngôn ngữ / chương trình giảng dạy bằng ngoại ngữ"},TOEFL_iBT:{label:"TOEFL iBT",threshold:46,type:"single",unit:"điểm"},IELTS:{label:"IELTS",threshold:5.5,type:"single",unit:"band"},TOEIC:{label:"TOEIC 4 kỹ năng",type:"multi",parts:[{k:"nghe",label:"Nghe",threshold:400},{k:"doc",label:"Đọc",threshold:385},{k:"noi",label:"Nói",threshold:160},{k:"viet",label:"Viết",threshold:150}]},Cambridge:{label:"Cambridge B2 First / Linguaskill",threshold:160,type:"single",unit:"điểm"},Aptis:{label:"Aptis ESOL B2",threshold:null,type:"b2",note:"Trình độ B2 (chứng chỉ từ 04/2023)"},VSTEP:{label:"VSTEP Bậc 4 (B2)",threshold:null,type:"b2",note:"Do cơ sở GDĐH được Bộ GD&ĐT công nhận cấp"},TCF:{label:"Tiếng Pháp - TCF",threshold:400,type:"single",unit:"điểm"},DELF:{label:"Tiếng Pháp - DELF B2",threshold:null,type:"b2"},Goethe:{label:"Tiếng Đức - Goethe B2",threshold:null,type:"b2"},TestDaF:{label:"Tiếng Đức - TestDaF TDN 4",threshold:null,type:"b2"},HSK:{label:"Tiếng Trung - HSK 4",threshold:null,type:"b2"},JLPT:{label:"Tiếng Nhật - JLPT N3",threshold:null,type:"b2"},TRKI:{label:"Tiếng Nga - ТРКИ-2",threshold:null,type:"b2"},TOPIK:{label:"Tiếng Hàn - TOPIK 4",threshold:null,type:"b2"}};const KEY='hcmus_master_tracker_v2';let store=JSON.parse(localStorage.getItem(KEY)||'{}');store.scores=store.scores||{};store.manual=store.manual||{};store.inProgress=store.inProgress||{};store.pt=store.pt||'PT1';store.tab=store.tab||'hocphan';store.ngoaiNgu=store.ngoaiNgu||{mien:false,cert:'IELTS',score:'',toeic:{nghe:'',doc:'',noi:'',viet:''},examDate:''};let url=location.href;if(url.includes('academic-results')){document.querySelectorAll('table tbody tr').forEach(tr=>{let tds=tr.querySelectorAll('td');if(tds.length>=5){let code=tds[1].innerText.trim();let sc=parseFloat(tds[4].innerText.replace(',','.').trim());if(code&&!isNaN(sc)){store.scores[code]=sc;if(sc>=5.0){tr.style.backgroundColor='#dcfce7';tr.style.borderLeft='4px solid #16a34a';}else{tr.style.backgroundColor='#fee2e2';tr.style.borderLeft='4px solid #dc2626';}}}});}else if(url.includes('course-registration-result')){store.inProgress={};document.querySelectorAll('table tbody tr').forEach(tr=>{let tds=tr.querySelectorAll('td');if(tds.length>=4){let code=tds[1].innerText.trim();if(code&&code.length<=10){store.inProgress[code]=true;tr.style.backgroundColor='#fef9c3';tr.style.borderLeft='4px solid #eab308';}}});}localStorage.setItem(KEY,JSON.stringify(store));let box=document.getElementById('master-tracker-box');if(box)box.remove();box=document.createElement('div');box.id='master-tracker-box';box.style.cssText='position:fixed;top:10px;right:10px;z-index:999999;background:#fff;border:2px solid #2563eb;border-radius:12px;padding:16px;width:500px;max-height:90vh;overflow-y:auto;box-shadow:0 10px 30px rgba(0,0,0,0.3);font-family:sans-serif;color:#1e293b;font-size:13px;';function getCr(code){for(let k in C){let f=C[k].find(x=>x.code===code);if(f)return f.credits;}return 0;}function daysLeft(d){if(!d)return null;let t=new Date(d);if(isNaN(t))return null;return Math.floor((t-new Date())/(1000*60*60*24));}function nnStatus(){let nn=store.ngoaiNgu;if(nn.mien)return{ok:true,msg:'Miễn ngoại ngữ qua văn bằng'};let c=NN[nn.cert];if(!c)return{ok:false,msg:'Chưa chọn chứng chỉ'};if(c.type==='b2')return{ok:true,msg:c.label+' — đạt B2',note:c.note||''};if(c.type==='single'){let v=parseFloat(nn.score);if(isNaN(v))return{ok:false,msg:'Chưa nhập điểm '+c.label};let ok=v>=c.threshold;return{ok:ok,msg:`${c.label}: ${v} / ${c.threshold} ${c.unit||''}`,note:ok?'✔ Đạt':'✘ Chưa đạt'};}if(c.type==='multi'){let all=true,parts=c.parts.map(p=>{let v=parseFloat(nn.toeic[p.k]);let ok=!isNaN(v)&&v>=p.threshold;if(!ok)all=false;return`${p.label}: ${isNaN(v)?'—':v}/${p.threshold} ${ok?'✔':'✘'}`;});return{ok:all,msg:'TOEIC 4 kỹ năng',note:parts.join(' | ')};}return{ok:false,msg:'—'};}function render(){let pt=PT[store.pt];let batBuocList=store.pt==='PT3'?C.bat_buoc_PT3:C.bat_buoc_PT12;let lvKey=store.pt==='PT3'?'do_an':'luan_van';let lvNeed=pt[lvKey];let tc=0;let tcChung=0,tcBatBuoc=0,tcTuChon=0,tcLV=0;let sumW10=0,sumW4=0,sumCr=0;Object.keys(store.scores).forEach(code=>{let sc=store.scores[code];if(sc>=5.0){let cr=getCr(code)||3;let sc4=sc>=8.5?4:sc>=7.0?3:sc>=5.5?2:sc>=4.0?1:0;sumW10+=sc*cr;sumW4+=sc4*cr;sumCr+=cr;}});let gpa10=sumCr>0?(sumW10/sumCr).toFixed(2):'0.00';let gpa4=sumCr>0?(sumW4/sumCr).toFixed(2):'0.00';function mkList(arr,group){return arr.map(m=>{let sc=store.scores[m.code];let ip=store.inProgress[m.code];let isPassed=sc!=null&&sc>=5.0;let isFailed=sc!=null&&sc<5.0;let hasScore=sc!=null;let isIP=ip&&!hasScore;let color='';if(isPassed)color='color:#16a34a;font-weight:bold;';else if(isFailed)color='color:#dc2626;font-weight:bold;';else if(isIP)color='color:#ca8a04;font-weight:bold;';let badge='';if(isPassed)badge=` <span style="color:#16a34a;">✔ ${sc}</span>`;else if(isFailed)badge=` <span style="color:#dc2626;">✘ ${sc}</span>`;else if(isIP)badge=' <span style="color:#ca8a04;">⏳</span>';let checked=(isPassed||isIP||store.manual[m.code])?'checked':'';let disabled=hasScore?'disabled':'';if(checked){tc+=m.credits;if(group==='chung')tcChung+=m.credits;else if(group==='bat_buoc')tcBatBuoc+=m.credits;else if(group==='tu_chon')tcTuChon+=m.credits;else if(group==='luan_van')tcLV+=m.credits;}return`<li style="margin:4px 0;${color}"><label style="cursor:pointer;"><input type="checkbox" data-code="${m.code}" ${checked} ${disabled} style="margin-right:6px;"> [<b>${m.code}</b>] ${m.name} (${m.credits} TC)${badge}</label></li>`;}).join('');}let cList=mkList(C.chung,'chung');let mList=mkList(batBuocList,'bat_buoc');let tList=mkList(C.tu_chon,'tu_chon');let lList=mkList(C.luan_van.filter(m=>store.pt==='PT3'?m.code==='MLV_PT3':m.code!=='MLV_PT3'),'luan_van');let mandOk=tcBatBuoc>=pt.bat_buoc;let chungOk=tcChung>=pt.triet;let tuChonOk=tcTuChon>=pt.tu_chon;let lvOk=tcLV>=lvNeed;let allOk=mandOk&&chungOk&&tuChonOk&&lvOk&&tc>=pt.total;let col=allOk?'#16a34a':'#2563eb';function statusRow(label,have,need){let ok=have>=need;return`<div style="font-size:12px;color:${ok?'#16a34a':'#dc2626'};margin:2px 0;">${ok?'✔':'✘'} ${label}: <b>${have} / ${need} TC</b></div>`;}let ptOptions=Object.keys(PT).map(k=>`<option value="${k}" ${store.pt===k?'selected':''}>${PT[k].name}</option>`).join('');let ipCount=Object.keys(store.inProgress).filter(c=>store.scores[c]==null).length;let tabHocPhan=`<div style="background:#eff6ff;padding:8px;border-radius:8px;margin-bottom:10px;border:1px solid #bfdbfe;"><label style="font-size:13px;"><b>Phương thức:</b> <select id="pt-select" style="padding:4px;border-radius:6px;border:1px solid #93c5fd;font-size:13px;">${ptOptions}</select></label></div><div style="background:#f8fafc;padding:10px;border-radius:8px;margin-bottom:12px;border:1px solid #e2e8f0;"><div style="font-size:14px;margin-bottom:6px;"><b>Tổng TC tích lũy:</b> <span style="color:${col};font-size:16px;"><b>${tc} / ${pt.total} TC</b></span></div><div style="font-size:14px;margin-bottom:6px;"><b>GPA (hệ 10):</b> <span style="color:#2563eb;font-size:16px;"><b>${gpa10}</b></span> <span style="color:#64748b;font-size:11px;">(${sumCr} TC có điểm)</span></div><div style="font-size:14px;margin-bottom:8px;"><b>GPA (hệ 4):</b> <span style="color:#7c3aed;font-size:16px;"><b>${gpa4}</b></span></div><div style="border-top:1px dashed #cbd5e1;padding-top:8px;"><div style="font-size:12px;font-weight:bold;color:#1e3a8a;margin-bottom:4px;">📋 Điều kiện đạt ${pt.name}:</div>${statusRow('Triết học',tcChung,pt.triet)}${statusRow('Môn bắt buộc',tcBatBuoc,pt.bat_buoc)}${statusRow('Môn tự chọn',tcTuChon,pt.tu_chon)}${statusRow(store.pt==='PT3'?'Đồ án':'Luận văn',tcLV,lvNeed)}<div style="font-size:12px;color:${allOk?'#16a34a':'#dc2626'};margin-top:6px;padding-top:6px;border-top:1px solid #e2e8f0;"><b>${allOk?'🎉 ĐỦ ĐIỀU KIỆN TỐT NGHIỆP':'⚠️ Chưa đủ điều kiện tốt nghiệp'}</b></div></div><div style="font-size:11px;color:#64748b;margin-top:6px;">✔ Passed (${Object.values(store.scores).filter(x=>x>=5).length}) | ✘ Failed (${Object.values(store.scores).filter(x=>x<5).length}) | ⏳ In-progress (${ipCount})</div></div><div style="margin-bottom:12px;"><b style="color:#1d4ed8;">📖 Kiến thức chung:</b><ul style="list-style:none;padding-left:0;margin:6px 0;">${cList}</ul></div><div style="margin-bottom:12px;"><b style="color:#1d4ed8;">📌 Môn Bắt buộc ${store.pt==='PT3'?'(PT3)':'(PT1/PT2)'}:</b><ul style="list-style:none;padding-left:0;margin:6px 0;">${mList}</ul></div><div style="margin-bottom:12px;"><b style="color:#047857;">📦 Môn Tự chọn:</b><ul style="list-style:none;padding-left:0;margin:6px 0;max-height:150px;overflow-y:auto;border:1px solid #e2e8f0;padding:6px;border-radius:6px;">${tList}</ul></div><div style="margin-bottom:12px;"><b style="color:#7c3aed;">🎓 ${store.pt==='PT3'?'Đồ án tốt nghiệp':'Luận văn tốt nghiệp'}:</b><ul style="list-style:none;padding-left:0;margin:6px 0;">${lList}</ul></div>`;let nn=store.ngoaiNgu;let certOptions=Object.keys(NN).filter(k=>k!=='mien_van_bang').map(k=>`<option value="${k}" ${nn.cert===k?'selected':''}>${NN[k].label}</option>`).join('');let c=NN[nn.cert];let dl=daysLeft(nn.examDate);let dlTxt='';let dlColor='#64748b';if(dl!=null){if(dl<0){dlTxt=`⚠️ Đã hết hạn ${-dl} ngày`;dlColor='#dc2626';}else if(dl<180){dlTxt=`⚠️ Còn ${dl} ngày (dưới 6 tháng)`;dlColor='#ca8a04';}else{dlTxt=`✔ Còn ${dl} ngày`;dlColor='#16a34a';}}let scoreInputs='';if(c&&c.type==='single'){scoreInputs=`<div style="margin:6px 0;"><label style="font-size:12px;">Điểm (ngưỡng ${c.threshold} ${c.unit||''}):<br><input type="number" step="0.1" id="nn-score" value="${nn.score}" style="width:100%;padding:4px;border:1px solid #cbd5e1;border-radius:4px;margin-top:2px;"></label></div>`;}else if(c&&c.type==='multi'){scoreInputs=c.parts.map(p=>`<div style="margin:4px 0;"><label style="font-size:12px;">${p.label} (ngưỡng ${p.threshold}):<br><input type="number" id="nn-${p.k}" value="${nn.toeic[p.k]||''}" style="width:100%;padding:4px;border:1px solid #cbd5e1;border-radius:4px;margin-top:2px;"></label></div>`).join('');}else if(c&&c.type==='b2'){scoreInputs=`<div style="font-size:12px;color:#64748b;padding:6px;background:#f1f5f9;border-radius:4px;">${c.note||'Chỉ cần có chứng chỉ đạt trình độ B2'}</div>`;}let st=nnStatus();let nnHtml=`<div style="background:#f0fdf4;padding:10px;border-radius:8px;margin-bottom:12px;border:1px solid #bbf7d0;"><label style="font-size:13px;cursor:pointer;"><input type="checkbox" id="nn-mien" ${nn.mien?'checked':''} style="margin-right:6px;"><b>Miễn ngoại ngữ qua văn bằng</b></label><div style="font-size:11px;color:#64748b;margin-top:4px;padding-left:22px;">Bằng ĐH toàn thời gian ở nước ngoài / ngành ngôn ngữ / chương trình giảng dạy bằng ngoại ngữ</div></div>${nn.mien?'':`<div style="background:#f8fafc;padding:10px;border-radius:8px;margin-bottom:12px;border:1px solid #e2e8f0;"><div style="margin-bottom:6px;"><label style="font-size:13px;"><b>Chứng chỉ:</b><br><select id="nn-cert" style="width:100%;padding:4px;border:1px solid #93c5fd;border-radius:6px;margin-top:2px;">${certOptions}</select></label></div>${scoreInputs}<div style="margin:6px 0;"><label style="font-size:12px;">Ngày thi (để tính hạn 24 tháng):<br><input type="date" id="nn-date" value="${nn.examDate}" style="width:100%;padding:4px;border:1px solid #cbd5e1;border-radius:4px;margin-top:2px;"></label>${dlTxt?`<div style="font-size:11px;color:${dlColor};margin-top:4px;">${dlTxt}</div>`:''}</div><div style="font-size:11px;color:#64748b;margin-top:6px;">Quy định: Bậc 4 (B2), hiệu lực 24 tháng — QĐ 315/QĐ-KHTN ngày 14/02/2025</div></div>`}<div style="background:${st.ok?'#dcfce7':'#fee2e2'};padding:10px;border-radius:8px;border:1px solid ${st.ok?'#86efac':'#fca5a5'};"><div style="font-size:14px;color:${st.ok?'#16a34a':'#dc2626'};"><b>${st.ok?'✔ ĐẠT CHUẨN NGOẠI NGỮ':'✘ CHƯA ĐẠT CHUẨN NGOẠI NGỮ'}</b></div><div style="font-size:12px;color:#475569;margin-top:4px;">${st.msg}</div>${st.note?`<div style="font-size:11px;color:#64748b;margin-top:2px;">${st.note}</div>`:''}</div>`;box.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #e2e8f0;padding-bottom:8px;margin-bottom:10px;"><h3 style="margin:0;font-size:15px;color:#1e3a8a;">🎓 Tracker Thạc sĩ VTMT-K35</h3><button id="close-tracker" style="border:none;background:transparent;font-weight:bold;cursor:pointer;font-size:16px;color:#64748b;">✕</button></div><div style="display:flex;gap:6px;margin-bottom:10px;"><button id="tab-hp" style="flex:1;padding:8px;border-radius:8px;border:1px solid ${store.tab==='hocphan'?'#2563eb':'#cbd5e1'};background:${store.tab==='hocphan'?'#2563eb':'#fff'};color:${store.tab==='hocphan'?'#fff':'#475569'};cursor:pointer;font-weight:bold;">📚 Học phần</button><button id="tab-nn" style="flex:1;padding:8px;border-radius:8px;border:1px solid ${store.tab==='ngoaingu'?'#2563eb':'#cbd5e1'};background:${store.tab==='ngoaingu'?'#2563eb':'#fff'};color:${store.tab==='ngoaingu'?'#fff':'#475569'};cursor:pointer;font-weight:bold;">🌐 Ngoại ngữ</button></div>${store.tab==='hocphan'?tabHocPhan:nnHtml}<div style="text-align:right;font-size:11px;color:#64748b;border-top:1px solid #e2e8f0;padding-top:8px;">* Chạy bookmarklet trên cả 2 trang để có đủ dữ liệu.</div>`;box.querySelector('#close-tracker').addEventListener('click',()=>box.remove());box.querySelector('#tab-hp').addEventListener('click',()=>{store.tab='hocphan';localStorage.setItem(KEY,JSON.stringify(store));render();});box.querySelector('#tab-nn').addEventListener('click',()=>{store.tab='ngoaingu';localStorage.setItem(KEY,JSON.stringify(store));render();});if(store.tab==='hocphan'){let sel=box.querySelector('#pt-select');if(sel)sel.addEventListener('change',e=>{store.pt=e.target.value;localStorage.setItem(KEY,JSON.stringify(store));render();});box.querySelectorAll('input[type="checkbox"]:not([disabled])').forEach(chk=>{chk.addEventListener('change',e=>{store.manual[e.target.dataset.code]=e.target.checked;localStorage.setItem(KEY,JSON.stringify(store));render();});});}else{let mien=box.querySelector('#nn-mien');if(mien)mien.addEventListener('change',e=>{store.ngoaiNgu.mien=e.target.checked;localStorage.setItem(KEY,JSON.stringify(store));render();});let cert=box.querySelector('#nn-cert');if(cert)cert.addEventListener('change',e=>{store.ngoaiNgu.cert=e.target.value;localStorage.setItem(KEY,JSON.stringify(store));render();});let sc=box.querySelector('#nn-score');if(sc)sc.addEventListener('input',e=>{store.ngoaiNgu.score=e.target.value;localStorage.setItem(KEY,JSON.stringify(store));render();});['nghe','doc','noi','viet'].forEach(k=>{let el=box.querySelector('#nn-'+k);if(el)el.addEventListener('input',e=>{store.ngoaiNgu.toeic[k]=e.target.value;localStorage.setItem(KEY,JSON.stringify(store));render();});});let dt=box.querySelector('#nn-date');if(dt)dt.addEventListener('change',e=>{store.ngoaiNgu.examDate=e.target.value;localStorage.setItem(KEY,JSON.stringify(store));render();});}}document.body.appendChild(box);render();})();
